package-as: Mailworthy

# The addon lives in Mailworthy/; ship only that folder (plus LICENSE, which the
# packager copies in). tools/check-package-layout.sh enforces this in CI.
move-folders:
  Mailworthy/Mailworthy: Mailworthy

# CurseForge relations (slugs), set by the packager on upload: Auctionator
# provides prices. Disenchantry (which switches on the disenchant comparison)
# is NOT listed: since 2026-10-20 CurseForge rejects the whole upload with
# "Invalid slug in project relations: 'disenchantry' does not exist, is not
# accessible, or belongs to an unrelated root category" (the v0.8.0 run), though
# v0.7.0 uploaded with it on 2026-10-14. The .toc's OptionalDeps still names it.
optional-dependencies:
  - auctionator

ignore:
  - spec
  - tools
  - docs
  - media
  - AGENTS.md
  - CLAUDE.md
  - README.md
