package-as: Mailworthy

# The addon lives in Mailworthy/; ship only that folder (plus LICENSE, which the
# packager copies in). tools/check-package-layout.sh enforces this in CI.
move-folders:
  Mailworthy/Mailworthy: Mailworthy

# CurseForge relations (slugs), set by the packager on upload: Auctionator
# provides prices, Disenchantry switches on the disenchant comparison.
optional-dependencies:
  - auctionator
  - disenchantry

ignore:
  - spec
  - tools
  - docs
  - media
  - AGENTS.md
  - CLAUDE.md
  - README.md
