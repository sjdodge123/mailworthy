package-as: Mailworthy

# The addon lives in Mailworthy/; ship only that folder (plus LICENSE, which the
# packager copies in). tools/check-package-layout.sh enforces this in CI.
move-folders:
  Mailworthy/Mailworthy: Mailworthy

# CurseForge relations (slugs), set by the packager on upload: Auctionator
# provides auction prices, Siz DisenchantValue and Disenchantry disenchant
# values. Every slug here must exist on CurseForge or the upload is refused
# ("Invalid slug in project relations", error 1018): the disenchantry project
# (1704637) vanished in October 2026 and failed v0.8.0 and v0.9.0, and is back
# since 2026-10-22. If a tag's CurseForge upload fails on it, drop it here and
# re-tag.
optional-dependencies:
  - auctionator
  - siz-disenchantvalue
  - disenchantry

ignore:
  - spec
  - tools
  - docs
  - media
  - AGENTS.md
  - CLAUDE.md
  - README.md
