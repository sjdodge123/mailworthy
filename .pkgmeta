package-as: Mailworthy

# The addon lives in Mailworthy/; ship only that folder (plus LICENSE, which the
# packager copies in). tools/check-package-layout.sh enforces this in CI.
move-folders:
  Mailworthy/Mailworthy: Mailworthy

# CurseForge relations (slugs), set by the packager on upload: Auctionator
# provides auction prices, Siz DisenchantValue disenchant values. Disenchantry
# (the old switch) is no longer a CurseForge project: its slug made the v0.8.0
# and v0.9.0 uploads fail with "Invalid slug in project relations"
# (2026-10-22), so it is only in the .toc's OptionalDeps. Every slug here must
# exist on CurseForge or the upload is refused.
optional-dependencies:
  - auctionator
  - siz-disenchantvalue

ignore:
  - spec
  - tools
  - docs
  - media
  - AGENTS.md
  - CLAUDE.md
  - README.md
